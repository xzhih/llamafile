+std::unique_ptr<server_res_generator> server_routes::handle_translategemma_request(
+            const server_http_req & req,
+            const json & body,
+            bool messages_mode) {
+    std::string error;
+    lf::chatbot::TranslateGemmaHttpRequest translate_req;
+    const bool ok = messages_mode
+        ? lf::chatbot::parse_translategemma_http_messages_request(body, &translate_req, &error)
+        : lf::chatbot::parse_translategemma_http_translate_request(body, &translate_req, &error);
+    if (!ok) {
+        auto res = create_response();
+        res->error(format_error_response(error, ERROR_TYPE_INVALID_REQUEST));
+        return res;
+    }
+
+    const char *template_cstr = llama_model_chat_template(ctx_server.model, nullptr);
+    const std::string template_source = template_cstr ? template_cstr : "";
+    if (!lf::chatbot::is_translategemma_chat_template_source(template_source)) {
+        auto res = create_response();
+        res->error(format_error_response(
+            "loaded model does not expose a TranslateGemma translation template",
+            ERROR_TYPE_NOT_SUPPORTED));
+        return res;
+    }
+    if (translate_req.request.has_media && ctx_server.mctx == nullptr) {
+        auto res = create_response();
+        res->error(format_error_response(
+            "multimodal model not loaded (use --mmproj to specify vision model)",
+            ERROR_TYPE_INVALID_REQUEST));
+        return res;
+    }
+
+    std::vector<raw_buffer> files;
+    const std::string media_placeholder = translate_req.request.has_media ? mtmd_default_marker() : "";
+    auto rendered = lf::chatbot::render_translategemma_request(
+        template_source,
+        ctx_server.vocab,
+        translate_req.request,
+        translate_req.translation_instruction,
+        media_placeholder);
+    for (const auto &bytes : rendered.image_bytes) {
+        files.emplace_back(bytes.begin(), bytes.end());
+    }
+
+    json generation = translate_req.generation;
+    generation["prompt"] = rendered.prompt;
+
+    return handle_completions_impl(
+        req,
+        SERVER_TASK_TYPE_COMPLETION,
+        generation,
+        files,
+        TASK_RESPONSE_TYPE_OAI_CHAT);
+}
