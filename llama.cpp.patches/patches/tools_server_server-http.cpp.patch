+namespace {
+
+constexpr size_t k_cosmo_http_worker_stack_size = 1u << 20;
+
+static size_t get_cosmo_http_worker_guard_size() {
+    long page_size = sysconf(_SC_PAGESIZE);
+    return page_size > 0 ? static_cast<size_t>(page_size) : 4096u;
+}
+
+class cosmo_http_task_queue final : public httplib::TaskQueue {
+public:
+    explicit cosmo_http_task_queue(size_t n_threads) {
+        workers_.reserve(n_threads);
+        for (size_t i = 0; i < n_threads; ++i) {
+            pthread_attr_t attr;
+            int rc = pthread_attr_init(&attr);
+            if (rc != 0) {
+                SRV_ERR("pthread_attr_init failed for HTTP worker %zu: %s\n", i, std::strerror(rc));
+                abort_startup();
+                return;
+            }
+            rc = pthread_attr_setstacksize(&attr, k_cosmo_http_worker_stack_size);
+            if (rc != 0) {
+                pthread_attr_destroy(&attr);
+                SRV_ERR("pthread_attr_setstacksize failed for HTTP worker %zu: %s\n", i, std::strerror(rc));
+                abort_startup();
+                return;
+            }
+            rc = pthread_attr_setguardsize(&attr, get_cosmo_http_worker_guard_size());
+            if (rc != 0) {
+                SRV_WRN("pthread_attr_setguardsize failed for HTTP worker %zu: %s\n", i, std::strerror(rc));
+            }
+
+            pthread_t worker = {};
+            rc = pthread_create(&worker, &attr, &cosmo_http_task_queue::worker_entry, this);
+            pthread_attr_destroy(&attr);
+            if (rc != 0) {
+                SRV_ERR("pthread_create failed for HTTP worker %zu: %s\n", i, std::strerror(rc));
+                abort_startup();
+                return;
+            }
+
+            workers_.push_back(worker);
+        }
+    }
+
+    ~cosmo_http_task_queue() override {
+        shutdown();
+    }
+
+    bool enqueue(std::function<void()> fn) override {
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            if (shutdown_ || workers_.empty()) {
+                return false;
+            }
+            jobs_.push_back(std::move(fn));
+        }
+        condition_.notify_one();
+        return true;
+    }
+
+    void shutdown() override {
+        std::vector<pthread_t> workers;
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            if (joined_) {
+                return;
+            }
+            shutdown_ = true;
+            joined_ = true;
+            workers = workers_;
+        }
+        condition_.notify_all();
+        for (pthread_t worker : workers) {
+            pthread_join(worker, nullptr);
+        }
+    }
+
+private:
+    static void * worker_entry(void * arg) {
+        static_cast<cosmo_http_task_queue *>(arg)->run_worker();
+        return nullptr;
+    }
+
+    void run_worker() {
+        sigset_t block_mask;
+        sigemptyset(&block_mask);
+        sigaddset(&block_mask, SIGINT);
+        sigaddset(&block_mask, SIGTERM);
+        int rc = pthread_sigmask(SIG_BLOCK, &block_mask, nullptr);
+        if (rc != 0) {
+            SRV_WRN("pthread_sigmask failed for HTTP worker: %s\n", std::strerror(rc));
+        }
+
+        while (true) {
+            std::function<void()> job;
+            {
+                std::unique_lock<std::mutex> lock(mutex_);
+                while (jobs_.empty() && !shutdown_) {
+                    condition_.wait_for(lock, std::chrono::seconds(30));
+                }
+                if (shutdown_ && jobs_.empty()) {
+                    break;
+                }
+                job = std::move(jobs_.front());
+                jobs_.pop_front();
+            }
+            job();
+        }
+    }
+
+    void abort_startup() {
+        std::vector<pthread_t> workers;
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            shutdown_ = true;
+            joined_ = true;
+            workers = workers_;
+            workers_.clear();
+        }
+        condition_.notify_all();
+        for (pthread_t worker : workers) {
+            pthread_join(worker, nullptr);
+        }
+    }
+
+    std::mutex mutex_;
+    std::condition_variable condition_;
+    std::deque<std::function<void()>> jobs_;
+    std::vector<pthread_t> workers_;
+    bool shutdown_ = false;
+    bool joined_ = false;
+};
+
+} // namespace
+#endif
 
